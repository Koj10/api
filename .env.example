SECRET_KEY=замените_на_случайную_строку_64_символа
DEBUG=False
JWT_ACCESS_EXPIRES_HOURS=24

# Почта: auto (Brevo если есть ключ, иначе SMTP) | brevo | smtp
# На VPS с блокировкой 587/465 используйте brevo или auto + BREVO_API_KEY
EMAIL_PROVIDER=auto
FROM_EMAIL=gamesense.ghost@gmail.com
FROM_NAME=GameSense
BREVO_API_KEY=

# Gmail SMTP (работает только если VPS не блокирует порты 587/465)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=gamesense.ghost@gmail.com
SMTP_PASSWORD=

SHOP_ID=
CASHBOX_ID=
ALLOWED_API_KEYS=

# Публичные URL (временно IP вместо домена)
PUBLIC_API_URL=http://77.91.100.153:6001
PUBLIC_SITE_URL=http://77.91.100.153:8100
PUBLIC_LANDING_URL=http://77.91.100.153:6200

# Опционально: ключ для внутренних запросов (заголовок X-API-Key).
# Сгенерируй: python -c "import secrets; print(secrets.token_hex(32))"
